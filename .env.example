# Clutch AI v2.0 Configuration
APP_NAME="Clutch AI API"
DEBUG=True
SECRET_KEY="clutch-ai-dev-secret-key-32-chars-long-minimum-v2"

# Database (defaults to local SQLite; for PostgreSQL use postgresql+asyncpg://user:pass@localhost:5432/clutch)
DATABASE_URL="sqlite+aiosqlite:///./data/clutch.db"

# LLM Providers (Optional: system works 100% offline with built-in RAG synthesizer)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""

# Local Ollama (if running ollama serve)
OLLAMA_BASE_URL="http://localhost:11434"

DEFAULT_LLM_PROVIDER="groq"
DEFAULT_MODEL="llama-3.3-70b-versatile"
